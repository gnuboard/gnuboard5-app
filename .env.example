# Copy to .env for local development (never commit .env).
# API base — dev vhost localhost is a loopback alias; physical devices need the PC LAN IP + Apache ServerAlias (OPS-01.1).
EXPO_PUBLIC_API_URL=http://localhost/api/v1

# Written by `npm run sync:app-name` (reads GET /settings → cf_title). Do not hand-edit for store builds.
# EXPO_PUBLIC_APP_NAME=그누보드5

# Filled after the new EAS / Sentry projects exist (OPS-01.3, OPS-01.5).
# EXPO_PUBLIC_EAS_PROJECT_ID=
# EXPO_PUBLIC_EAS_OWNER=
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_SENTRY_ORG=
# EXPO_PUBLIC_SENTRY_PROJECT=
# EXPO_PUBLIC_APP_STORE_URL=
